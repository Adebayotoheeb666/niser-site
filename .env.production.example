NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Email
BREVO_API_KEY=

# Firebase / FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# AI / Search
# Google Gemini (cloud LLM + embeddings) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Truncate embedding vectors (recommended: 768, 1536, 3072). Changing the embedding
# model/dimensionality requires re-indexing the Qdrant collection.
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=768

# Ollama (self-hosted alternative) - set to your Ollama HTTP endpoint
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama-3.1-8b

# Provider selection: `ollama`, `gemini`, `claude`, or `auto` (default: ollama → gemini → claude)
AI_PROVIDER=auto
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Qdrant (vector DB) - example: http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=niser_documents

# Elasticsearch (optional keyword search)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=niser_content

# Analytics / Monitoring
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
SENTRY_DSN=
 
# Policy monitor
POLICY_MONITOR_FEED_URL=
# Comma-separated hostnames permitted for the configured feed, e.g. www.gov.ng
POLICY_MONITOR_ALLOWED_HOSTS=
POLICY_MONITOR_ALERT_EMAIL=

# Ingest/webhook secret used by the CMS to trigger indexing
WEBHOOK_SECRET=
INTERNAL_AI_SECRET=
# Admin-only gating for internal AI endpoints (policy-brief, ingest, embed).
# Secure by default: leave unset or "true" to require INTERNAL_AI_SECRET /
# WEBHOOK_SECRET. Set explicitly to "false" only for trusted internal demos.
AI_ADMIN_ONLY_POLICY_BRIEF=true
AI_ADMIN_ONLY_INGEST=true
AI_ADMIN_ONLY_EMBED=true
# CKAN open data portal (leave empty to serve datasets from the CMS)
CKAN_API_URL=
# CKAN_API_URL=http://localhost:5000
CKAN_API_KEY=
# Policy monitor feeds (comma-separated RSS/Atom URLs; falls back to POLICY_MONITOR_FEED_URL)
POLICY_MONITOR_FEED_URLS=
MATOMO_TOKEN_AUTH=
# Public chatbot: set a lower quota for anonymous visitors. Optional Turnstile
# verification activates automatically when TURNSTILE_SECRET_KEY is set.
PUBLIC_CHAT_RATE_LIMIT_MAX=10
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CHAT_MIN_RETRIEVAL_SCORE=0.35
LITERATURE_MIN_RETRIEVAL_SCORE=0.35

# Translation backend: `nllb` (self-hosted), `gemini`, or `auto` (default: NLLB if
# NLLB_SERVICE_URL is set, else Gemini using GEMINI_API_KEY).
# NLLB_SERVICE_URL=
# TRANSLATION_PROVIDER=auto

# External/general knowledge fallback for the chatbot.
# When the NISER repository has no relevant results the assistant falls back to
# (1) external web search (Tavily) if WEB_SEARCH_API_KEY is set, then
# (2) general knowledge for non-NISER questions unless CHAT_GENERAL_KNOWLEDGE=false.
# General knowledge is never used for questions about NISER's own research.
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
CHAT_GENERAL_KNOWLEDGE=true

# Cloudflare cache purging (used by lib/cloudflare-cache.ts and /api/revalidate)
# Zone ID: Cloudflare Dashboard → niser.gov.ng → Overview → right sidebar
CLOUDFLARE_ZONE_ID=
# API Token: Cloudflare → My Profile → API Tokens → Create Token (add Zone > Cache Purge permission)
CLOUDFLARE_API_TOKEN=
# ISR webhook secret — authenticates CMS → /api/revalidate webhook calls
# Generate with: openssl rand -hex 32
ISR_REVALIDATE_TOKEN=
